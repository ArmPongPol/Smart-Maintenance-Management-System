# Local development settings. This file is gitignored — never commit it.
# Validated at startup by src/config/env.validation.ts.

# ---------- App ----------
NODE_ENV=development
APP_NAME=my-project
PORT=3001
API_PREFIX=
API_VERSION=
# Comma-separated list of allowed frontend origins, e.g. http://localhost:5173
CORS_ORIGINS=
CORS_CREDENTIALS=true

# ---------- Database ----------
# Also read by docker-compose.yaml, so the container and the app use the same credentials.
# The app runs on the host, so it reaches the Postgres container through localhost.
HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_DATABASE=my_project
# Keep false: the schema is managed by migrations (npm run migration:run).
# If true, the app creates tables on startup and migration:run then fails.
DATABASE_SYNCHRONIZE=false
DB_LOGGING=false
DATABASE_SSL=false

# ---------- Docs (Swagger) ----------
DOCS_ENABLED=true
DOCS_PATH=docs
DOCS_DESCRIPTION=

# ---------- JWT ----------
# Random secrets generated for this machine (at least 32 chars, and they must differ).
JWT_ACCESS_SECRET=g1fSccBv-oa-0ZDsaE3nxgS8Jlfqv27apqy9bi24zqjj5uRkL05IleGUicJ7V3XU
JWT_REFRESH_SECRET=CPvontII-WFNbao-mHcffnbQ6kVuatcWuMMSvqTw6oOZdIFJDqUgvGyX8Ns57ARR
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-service-clients
